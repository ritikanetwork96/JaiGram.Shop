{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 15
    }
  },
  "redirects": [
    { "source": "/.env(.*)", "destination": "/", "statusCode": 302 },
    { "source": "/.git(.*)", "destination": "/", "statusCode": 302 },
    { "source": "/database.rules.json", "destination": "/", "statusCode": 302 },
    { "source": "/package.json", "destination": "/", "statusCode": 302 },
    { "source": "/package-lock.json", "destination": "/", "statusCode": 302 },
    { "source": "/dev-server.mjs", "destination": "/", "statusCode": 302 },
    { "source": "/.gitignore", "destination": "/", "statusCode": 302 },
    { "source": "/index.html", "destination": "/", "statusCode": 301 },
    { "source": "/about.html", "destination": "/about", "statusCode": 301 },
    { "source": "/payment.html", "destination": "/payment", "statusCode": 301 },
    { "source": "/login.html", "destination": "/login", "statusCode": 301 },
    { "source": "/legal.html", "destination": "/legal", "statusCode": 301 },
    { "source": "/admin/index.html", "destination": "/admin", "statusCode": 301 },
    { "source": "/admin/login.html", "destination": "/admin/login", "statusCode": 301 },
    { "source": "/seller/index.html", "destination": "/seller", "statusCode": 301 },
    { "source": "/seller/login.html", "destination": "/seller/login", "statusCode": 301 },
    { "source": "/seller/apply.html", "destination": "/seller/apply", "statusCode": 301 },
    { "source": "/seller/dashboard.html", "destination": "/seller/dashboard", "statusCode": 301 },
    { "source": "/user/index.html", "destination": "/user", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/media/(.*)", "destination": "/api/media?path=$1" },
    { "source": "/seller.css", "destination": "/seller/seller.css" },
    { "source": "/assets/(.*)", "destination": "/admin/assets/$1" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/payment", "destination": "/payment.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/legal", "destination": "/legal.html" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/login", "destination": "/admin/login.html" },
    { "source": "/admin/(.*)", "destination": "/admin/index.html" },
    { "source": "/seller", "destination": "/seller/index.html" },
    { "source": "/seller/login", "destination": "/seller/login.html" },
    { "source": "/seller/apply", "destination": "/seller/apply.html" },
    { "source": "/seller/dashboard", "destination": "/seller/dashboard.html" },
    { "source": "/seller/(.*)", "destination": "/seller/index.html" },
    { "source": "/user", "destination": "/user/index.html" },
    { "source": "/user/(.*)", "destination": "/user/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/(admin|seller)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/(index|about|payment|admin|login|seller)?",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(images|assets)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(webp|jpg|jpeg|png|gif|svg|ico|woff|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ]
}
