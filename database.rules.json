{
  "rules": {
    ".read": false,
    ".write": false,
    "products": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'ritikanetwork96@gmail.com'"
    },
    "categories": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'ritikanetwork96@gmail.com'"
    },
    "banner": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'ritikanetwork96@gmail.com'"
    },
    "hero": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'ritikanetwork96@gmail.com'"
    },
    "faq": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'ritikanetwork96@gmail.com'"
    },
    "testimonials": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'ritikanetwork96@gmail.com'"
    },
    "settings": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'ritikanetwork96@gmail.com'"
    },
    "payment": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'ritikanetwork96@gmail.com'"
    },
    "media": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'ritikanetwork96@gmail.com'"
    },
    "reviews": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'ritikanetwork96@gmail.com'"
    },
    "analytics": {
      ".read": "auth != null && auth.token.email === 'ritikanetwork96@gmail.com'",
      ".write": "auth != null && auth.token.email === 'ritikanetwork96@gmail.com'"
    },
    "admin_sessions": {
      ".read": "auth != null && auth.token.email === 'ritikanetwork96@gmail.com'",
      ".write": "auth != null && auth.token.email === 'ritikanetwork96@gmail.com'"
    },
    "visitors": {
      ".read": "auth != null && auth.token.email === 'ritikanetwork96@gmail.com'",
      ".write": "auth != null && auth.token.email === 'ritikanetwork96@gmail.com'",
      "$visitor_id": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['timestamp']) || newData.hasChildren(['createdAt']) || newData.hasChildren(['date']) || newData.isNumber()"
      }
    },
    "events": {
      ".read": "auth != null && auth.token.email === 'ritikanetwork96@gmail.com'",
      ".write": "auth != null && auth.token.email === 'ritikanetwork96@gmail.com'",
      "orders": {
        ".read": "auth != null && auth.token.email === 'ritikanetwork96@gmail.com'",
        ".write": "auth != null && auth.token.email === 'ritikanetwork96@gmail.com'"
      },
      "customers": {
        ".read": "auth != null && auth.token.email === 'ritikanetwork96@gmail.com'",
        ".write": "auth != null && auth.token.email === 'ritikanetwork96@gmail.com'"
      },
      "seller_applications": {
        ".read": "auth != null && auth.token.email === 'ritikanetwork96@gmail.com'",
        ".write": "auth != null && auth.token.email === 'ritikanetwork96@gmail.com'"
      },
      "$event_id": {
        ".write": "!data.exists() && newData.exists() && $event_id !== 'orders' && $event_id !== 'customers' && $event_id !== 'seller_applications'",
        ".validate": "newData.hasChildren(['timestamp']) || newData.hasChildren(['createdAt']) || newData.hasChildren(['date'])"
      }
    },
    "customers": {
      ".read": "auth != null && auth.token.email === 'ritikanetwork96@gmail.com'",
      ".write": "auth != null && auth.token.email === 'ritikanetwork96@gmail.com'",
      "$customer_id": {
        ".read": "auth != null && (auth.token.email === 'ritikanetwork96@gmail.com' || auth.uid === $customer_id)",
        ".write": "auth != null && (auth.token.email === 'ritikanetwork96@gmail.com' || auth.uid === $customer_id)"
      }
    },
    "seller_applications": {
      ".read": "auth != null && auth.token.email === 'ritikanetwork96@gmail.com'",
      ".write": "auth != null && auth.token.email === 'ritikanetwork96@gmail.com'"
    },
    "public_sellers": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'ritikanetwork96@gmail.com'"
    },
    "store_followers": {
      ".read": true,
      "$store_key": {
        ".write": "auth != null && auth.token.email === 'ritikanetwork96@gmail.com' || newData.hasChildren(['count']) || !newData.exists()",
        "count": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "storeName": {
          ".validate": "newData.isString() && newData.val().length < 150"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "followers": {
          "$follower_id": {
            ".write": true,
            ".validate": "newData.isNumber() || !newData.exists()"
          }
        }
      }
    },
    "sellers": {
      ".read": "auth != null && auth.token.email === 'ritikanetwork96@gmail.com'",
      ".write": "auth != null && auth.token.email === 'ritikanetwork96@gmail.com'"
    },
    "orders": {
      ".read": "auth != null && auth.token.email === 'ritikanetwork96@gmail.com'",
      ".write": "auth != null && auth.token.email === 'ritikanetwork96@gmail.com'",
      "$order_id": {
        ".read": "auth != null && (auth.token.email === 'ritikanetwork96@gmail.com' || auth.uid === data.child('customerUid').val())",
        ".write": "auth != null && auth.token.email === 'ritikanetwork96@gmail.com'"
      }
    },
    "reports": {
      ".read": "auth != null && auth.token.email === 'ritikanetwork96@gmail.com'",
      ".write": "auth != null && auth.token.email === 'ritikanetwork96@gmail.com'",
      "$report_id": {
        ".read": "auth != null && (auth.token.email === 'ritikanetwork96@gmail.com' || auth.uid === data.child('reporterUid').val())",
        ".write": "!data.exists() && newData.exists()"
      }
    }
  }
}